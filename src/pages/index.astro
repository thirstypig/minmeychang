---
import Base from '../layouts/Base.astro'
import Videos from '../components/Videos.astro'
import { getTranslation } from '../i18n/ui'
import { confirmedFacts } from '../data/facts'

const locale = 'en' as const
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// Sourced from facts.ts rather than duplicated into ui.ts — her name lives in
// exactly one place, and it renders here only because it is confirmed. If the
// fact were ever downgraded to 'unverified', this disappears automatically.
const chineseName = confirmedFacts.find((f) => f.id === 'chinese-name')?.zhHant
---

<Base locale={locale}>
  <div class="mx-auto max-w-2xl px-6 py-16 sm:py-28">
    <h1 class="text-4xl sm:text-6xl tracking-tight" style="color: var(--brand)">
      {t('siteName')}
      {
        chineseName && (
          /* lang is load-bearing, not decoration: it tells screen readers to
             switch to Chinese pronunciation mid-heading, and it selects the
             Chinese typeface via the [lang^='zh'] rule. */
          <span
            lang="zh-Hant"
            class="mt-3 block text-2xl sm:text-3xl font-normal tracking-normal"
            style="color: var(--text-soft)"
          >
            {chineseName}
          </span>
        )
      }
    </h1>

    <p
      class="mt-8 text-xl sm:text-2xl leading-relaxed"
      style="color: var(--text-strong)"
    >
      {t('siteTagline')}
    </p>

    <h2 class="mt-16 text-2xl" style="color: var(--brand)">{t('talksHeading')}</h2>
    <p class="mt-3 text-base leading-relaxed" style="color: var(--text-soft)">
      {t('talksIntro')}
    </p>
    <Videos locale={locale} limit={3} />

    <p class="mt-12">
      <a href="/archive" class="underline underline-offset-4" style="color: var(--brand)"
        >{t('archiveTitle')}</a
      >
    </p>

    <p class="mt-12 text-base" style="color: var(--text-soft)">
      {t('holdingNotice')}
    </p>
  </div>
</Base>
