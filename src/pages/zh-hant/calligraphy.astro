---
import Page from '../../layouts/Page.astro'
import ArchivePage from '../../components/ArchivePage.astro'
import { calligraphyItems } from '../../data/archive'
import { getTranslation } from '../../i18n/ui'

const locale = 'zh-hant' as const
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)
---

<Page locale={locale} current="calligraphy" heading={t('calligraphyHeading')}>
  <ArchivePage locale={locale} items={calligraphyItems} factIds={['calligraphy']} />
</Page>
