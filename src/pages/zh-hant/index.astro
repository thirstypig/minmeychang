---
import Base from '../../layouts/Base.astro'
import Videos from '../../components/Videos.astro'
import { getTranslation, ui } from '../../i18n/ui'

const locale = 'zh-hant' as const
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// The name she uses in English, mirroring how the English page carries 張馬敏妹.
// Deliberately ui.en.siteName ("Min Mey Chang") rather than the chinese-name
// fact's `en` field ("Chang Ma Min-Mey") — the latter romanises the Chinese
// form and is not the name she goes by.
const englishName = ui.en.siteName
---

<Base locale={locale}>
  <div class="mx-auto max-w-2xl px-6 py-16 sm:py-28">
    <h1 class="text-4xl sm:text-6xl tracking-tight" style="color: var(--brand)">
      {t('siteName')}
      <span
        lang="en"
        class="mt-3 block text-2xl sm:text-3xl font-normal tracking-normal"
        style="color: var(--text-soft)"
      >
        {englishName}
      </span>
    </h1>

    <p
      class="mt-8 text-xl sm:text-2xl leading-relaxed"
      style="color: var(--text-strong)"
    >
      {t('siteTagline')}
    </p>

    <h2 class="mt-16 text-2xl" style="color: var(--brand)">{t('talksHeading')}</h2>
    <p class="mt-3 text-base" style="color: var(--text-soft)">{t('talksIntro')}</p>
    <Videos locale={locale} limit={3} />

    <p class="mt-12">
      <a
        href="/zh-hant/archive"
        class="underline underline-offset-4"
        style="color: var(--brand)">{t('archiveTitle')}</a
      >
    </p>

    <p class="mt-12 text-base" style="color: var(--text-soft)">
      {t('holdingNotice')}
    </p>
  </div>
</Base>
