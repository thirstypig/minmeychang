---
import Page from '../../layouts/Page.astro'
import ArchivePage from '../../components/ArchivePage.astro'
import { itemsForPage } from '../../data/archive'
import { getTranslation } from '../../i18n/ui'
import { routePath } from '../../i18n/routes'

const locale = 'zh-hant' as const
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// Her temple membership and volunteering (James, 2026-11-23), the Arcadia
// chapter of Buddha's Light International Association she founded (two
// published sources), and her Lunar New Year calligraphy, which includes
// Hsi Lai, as one line linking to the Calligraphy page (the full
// paragraph is there; design review 2026-11-23). No claim here that is not already sourced in facts.ts.
const factIds = ['hsi-lai-member', 'blia']
---

<Page locale={locale} current="temple" heading={t('templeHeading')}>
  <ArchivePage
    locale={locale}
    items={itemsForPage('buddhist')}
    factIds={factIds}
    groupByDecade
    anchorId="buddhist"
    seeAlso={{ text: t('templeCalligraphyLine'), href: routePath(locale, 'calligraphy') }}
  />
</Page>
