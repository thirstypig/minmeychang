---
import Page from '../../layouts/Page.astro'
import FactList from '../../components/FactList.astro'
import Affiliations from '../../components/Affiliations.astro'
import { getTranslation } from '../../i18n/ui'

const locale = 'zh-hant' as const
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)
---

<Page locale={locale} current="service" heading={t('factsHeading')}>
  <FactList locale={locale} />
  <Affiliations locale={locale} />
</Page>
