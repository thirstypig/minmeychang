---
interface Props {
  size?: number
  class?: string
}

const { size = 56, class: className = '' } = Astro.props
---

{/* Her complete name as a 印泥 chop — the cinnabar seal stamped on Chinese
    calligraphy, and the source of this site's color. The same mark as the
    favicon.

    All four characters, not just 張: the surname alone names her husband's
    family, while 張馬敏妹 is the 冠夫姓 form carrying her own maiden surname 馬
    inside it. Set 2x2 so every character stays legible at small sizes.

    Inline SVG rather than an image so it inherits --brand and flips with the
    theme. Labeled rather than aria-hidden: unlike an ornamental chop, this
    one carries her name and is the site's mark. */}
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={className}
  role="img"
  aria-label="張馬敏妹"
>
  <rect width="64" height="64" rx="7" fill="var(--brand)"></rect>
  <g
    fill="var(--brand-contrast)"
    font-family="var(--font-serif-tc)"
    font-size="27"
    text-anchor="middle"
  >
    <text x="18" y="20" dominant-baseline="central">張</text>
    <text x="46" y="20" dominant-baseline="central">馬</text>
    <text x="18" y="46" dominant-baseline="central">敏</text>
    <text x="46" y="46" dominant-baseline="central">妹</text>
  </g>
</svg>
