---
import { neighbors, routePath, type RouteId } from '../i18n/routes'
import { getTranslation, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  current: RouteId
}

const { locale, current } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// Splitting the site into pages risks losing the arc of a life story. These
// links restore the reading order, so someone can go start to finish without
// returning to a menu between every page.
const { previous, next } = neighbors(current)
---

{/* Two half-width buttons rather than small text links: at the foot of a
    long page this is the only "what next" (design review, 2026-11-23). An
    empty cell keeps "next" on the right on the first page. */}
{
  (previous || next) && (
    <nav
      class="no-print mt-20 grid grid-cols-2 gap-3 border-t pt-6 text-base"
      style="border-color: var(--rule)"
      aria-label={t('navLabel')}
    >
      <div>
        {previous && (
          <a href={routePath(locale, previous.id)} rel="prev" class="page-nav-button justify-start text-left">
            <span aria-hidden="true">←</span>
            <span>{t(previous.labelKey)}</span>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a href={routePath(locale, next.id)} rel="next" class="page-nav-button justify-end text-right">
            <span>{t(next.labelKey)}</span>
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </nav>
  )
}
