---
import { neighbours, routePath, type RouteId } from '../i18n/routes'
import { getTranslation, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  current: RouteId
}

const { locale, current } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// Splitting the site into pages risks losing the arc of a life story. These
// links restore the reading order, so someone can go start to finish without
// returning to a menu between every page.
const { previous, next } = neighbours(current)
---

{
  (previous || next) && (
    <nav
      class="no-print mt-20 flex items-center justify-between gap-4 border-t pt-6 text-base"
      style="border-color: var(--rule)"
      aria-label={t('navLabel')}
    >
      <div>
        {previous && (
          <a
            href={routePath(locale, previous.id)}
            class="tap-target underline-offset-4 hover:underline"
            style="color: var(--text-soft)"
          >
            <span aria-hidden="true">←</span> {t(previous.labelKey)}
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a
            href={routePath(locale, next.id)}
            class="tap-target underline-offset-4 hover:underline"
            style="color: var(--brand)"
          >
            {t(next.labelKey)} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </nav>
  )
}
