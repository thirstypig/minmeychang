---
import sharp from 'sharp'
import {
  archiveCategoryLabels,
  buildArchiveSections,
  recentlyAdded,
  suppliedItems,
  type ArchiveItem,
} from '../data/archive'
import { linkableAccounts } from '../data/media'
import { getTranslation, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)
const pick = (v: { en: string; zhHant: string }) =>
  locale === 'en' ? v.en : v.zhHant

const sections = buildArchiveSections()
const recent = recentlyAdded()

// Every image gets explicit width/height. Without them the grid reflows as each
// lazy image arrives, and a link to #some-photo lands wherever the photo WAS —
// on 2026-09-29 the gala photos drifted ~1,200px while the page loaded.
// Measured from the files at build time, so the numbers cannot go stale.
const thumbPath = (asset: string) => asset.replace('/archive/', '/archive/thumbs/')
type Dims = { w: number; h: number; tw: number; th: number }
const dims = new Map<string, Dims>(
  await Promise.all(
    suppliedItems.map(async (i): Promise<[string, Dims]> => {
      const [full, thumb] = await Promise.all([
        sharp(`public${i.asset}`).metadata(),
        sharp(`public${thumbPath(i.asset!)}`).metadata(),
      ])
      return [i.id, { w: full.width!, h: full.height!, tw: thumb.width!, th: thumb.height! }]
    })
  )
)

const photoCount = (items: ArchiveItem[]) => items.filter((i) => i.asset).length
const decadeAnchor = (category: string, decade: number) => `${category}-${decade}s`
---

{/* `data-archive` scopes the lightbox script. Captions render in the page and
    are hidden only once that script runs (data-gallery="on"), so without
    JavaScript every thumbnail is still a plain link to the full photograph
    and every caption is still readable. */}
<div data-archive>
  <nav class="archive-nav sticky top-0 z-10 -mx-6 mt-8 px-6 py-3" aria-label={t('archiveJumpNav')}>
    {/* Scrolls sideways on a phone, where a wrapped sticky bar would eat the
        screen; wraps on wider screens, where a hidden scrollbar cut off the
        last two sections with no sign they were there. */}
    <ul class="flex gap-x-5 gap-y-1 overflow-x-auto whitespace-nowrap text-sm list-none p-0 sm:flex-wrap sm:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {recent.length > 0 && (
        <li>
          <a href="#recent" class="underline underline-offset-4" style="color: var(--brand)">
            {t('archiveRecent')}
          </a>
        </li>
      )}
      {sections.map((s) => (
        <li>
          <a href={`#${s.category}`} class="underline underline-offset-4" style="color: var(--brand)">
            {pick(archiveCategoryLabels[s.category])}
          </a>
          <span class="tabular-nums" style="color: var(--text-soft)"> {photoCount(s.items)}</span>
        </li>
      ))}
    </ul>
  </nav>

  {
    recent.length > 0 && (
      <section class="archive-anchor mt-10" id="recent">
        <h2 class="text-2xl" style="color: var(--brand)">
          {t('archiveRecent')}
        </h2>
        <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 list-none p-0">
          {recent.map((item) => (
            /* No `id` here: the same item also appears in its own section,
               and that one owns the anchor. */
            <li>
              <a
                href={item.asset}
                class="archive-open block"
                data-id={item.id}
              >
                <img
                  src={thumbPath(item.asset!)}
                  width={dims.get(item.id)!.tw}
                  height={dims.get(item.id)!.th}
                  alt={pick({ en: item.en, zhHant: item.zhHant })}
                  class={`aspect-square w-full rounded object-cover ${item.kind === 'document' ? 'object-top' : ''}`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <p class="mt-2 text-sm leading-snug" style="color: var(--text-strong)">
                {pick({ en: item.en, zhHant: item.zhHant })}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    sections.map((s) => (
      <section class="archive-anchor mt-14" id={s.category}>
        <h2 class="text-2xl" style="color: var(--brand)">
          {pick(archiveCategoryLabels[s.category])}
          <span class="text-base tabular-nums" style="color: var(--text-soft)"> {photoCount(s.items)}</span>
        </h2>

        {s.decades.length > 1 && (
          <nav class="mt-2 flex flex-wrap gap-x-4 text-sm" aria-label={t('archiveDecadeNav')}>
            {s.decades.map((decade) => (
              <a
                href={`#${decadeAnchor(s.category, decade)}`}
                class="tabular-nums underline underline-offset-4"
                style="color: var(--brand)"
              >
                {decade}s
              </a>
            ))}
          </nav>
        )}

        {s.decades.map((decade) => (
          <div class="archive-anchor mt-8" id={decadeAnchor(s.category, decade)}>
            <h3 class="text-lg tabular-nums" style="color: var(--text-strong)">
              {decade}s
            </h3>

            <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 list-none p-0">
              {s.items
                .filter((item) => item.decade === decade)
                .map((item) => (
                  <li id={item.id} class="archive-anchor">
                    {item.asset ? (
                      <a
                        href={item.asset}
                        class="archive-open block"
                        data-id={item.id}
                        data-w={dims.get(item.id)!.w}
                        data-h={dims.get(item.id)!.h}
                      >
                        <img
                          src={thumbPath(item.asset)}
                          width={dims.get(item.id)!.tw}
                          height={dims.get(item.id)!.th}
                          alt={pick({ en: item.en, zhHant: item.zhHant })}
                          class={`aspect-square w-full rounded object-cover ${item.kind === 'document' ? 'object-top' : ''}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    ) : (
                      /* Placeholder state: the archive's shape is reviewable before
                         any scanning has happened, so gaps are visible rather than
                         silently absent. */
                      <div
                        class="placeholder-frame flex aspect-square items-center justify-center rounded border border-dashed p-4 text-center text-sm"
                        style="border-color: var(--rule); color: var(--text-soft)"
                      >
                        <span>{item.needs ? pick(item.needs) : t('archiveAwaiting')}</span>
                      </div>
                    )}

                    <p class="archive-title mt-2 text-sm leading-snug" style="color: var(--text-strong)">
                      {pick({ en: item.en, zhHant: item.zhHant })}
                    </p>

                    {/* The label names the thing; the caption explains it to someone
                        who recognises nobody in the photograph. Kept out of `alt`,
                        which stays the short label — a screen reader announcing a
                        four-line provenance note before every image would be worse
                        than useless. With the gallery on, it moves into the
                        lightbox; the element stays so the script reads it from
                        here rather than from a second copy. */}
                    {item.caption && (
                      <p class="archive-caption mt-1 text-sm leading-relaxed" style="color: var(--text-soft)">
                        {pick(item.caption)}
                      </p>
                    )}
                  </li>
                ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }

  {/* tabindex="-1" so the script can focus the dialog itself on open.
      Otherwise the browser focuses the first button and paints a focus ring
      on the close control every time the viewer opens. `autofocus` on the
      dialog was tried first and did not hold on every browser. */}
  <dialog class="lightbox" aria-label={t('archiveTitle')} tabindex="-1">
    <div class="lb-frame">
      <button type="button" class="lb-close tap-target" aria-label={t('lightboxClose')}>✕</button>
      <figure class="lb-figure">
        <img class="lb-img" alt="" />
        <figcaption>
          <p class="lb-title" style="color: var(--text-strong)"></p>
          <p class="lb-caption mt-1 text-sm leading-relaxed" style="color: var(--text-soft)"></p>
          <p class="lb-count mt-2 text-xs tabular-nums" style="color: var(--text-soft)"></p>
        </figcaption>
      </figure>
      <button type="button" class="lb-prev tap-target" aria-label={t('lightboxPrev')}>‹</button>
      <button type="button" class="lb-next tap-target" aria-label={t('lightboxNext')}>›</button>
    </div>
  </dialog>
</div>

{
  linkableAccounts.length > 0 && (
    <section class="mt-16">
      <h2 class="text-lg" style="color: var(--brand)">
        {t('mediaHeading')}
      </h2>
      <ul class="mt-4 space-y-2 list-none p-0">
        {linkableAccounts.map((account) => (
          <li>
            <a
              href={account.url}
              rel="noopener me"
              class="underline underline-offset-4"
              style="color: var(--brand)"
            >
              {pick({ en: account.en, zhHant: account.zhHant })}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .archive-nav {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }
  /* Keep headings and linked photos clear of the sticky bar when jumped to. */
  .archive-anchor {
    scroll-margin-top: 4rem;
  }
  [data-gallery='on'] .archive-caption {
    display: none;
  }
  .archive-open:focus-visible img {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .lightbox {
    /* Tailwind's preflight zeroes the margin a <dialog> uses to center
       itself; put it back. */
    margin: auto;
    width: min(100vw, 64rem);
    max-width: 100vw;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--surface);
    color: var(--text-strong);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  .lb-frame {
    position: relative;
    padding: 3rem 3.25rem 1.25rem;
  }
  .lb-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 12rem);
    margin: 0 auto;
    border-radius: 0.25rem;
  }
  .lb-figure figcaption {
    max-width: 60ch;
    margin: 1rem auto 0;
  }
  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--brand);
    font-size: 1.75rem;
    line-height: 1;
  }
  .lb-close {
    top: 0.25rem;
    right: 0.25rem;
    font-size: 1.25rem;
  }
  .lb-prev,
  .lb-next {
    top: 40%;
  }
  .lb-prev {
    left: 0.25rem;
  }
  .lb-next {
    right: 0.25rem;
  }
  .lb-close:focus-visible,
  .lb-prev:focus-visible,
  .lb-next:focus-visible {
    outline: 3px solid var(--brand);
  }
  .lightbox:focus {
    outline: none;
  }
  @media (max-width: 40rem) {
    /* The bottom padding is the arrows' own row, below the count — without
       it the left arrow sat on top of "98 / 143". */
    .lb-frame {
      padding: 3rem 0.75rem 3.5rem;
    }
    /* On a phone the arrows sit under the photo instead of over its edges;
       swiping also works. */
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.25rem;
    }
  }
</style>

<script>
  // Progressive enhancement over plain links. Everything the page shows works
  // without this; it adds the in-page viewer, arrow/swipe navigation, and a
  // per-photo URL (#<item id>) that opens the viewer when shared.
  const root = document.querySelector<HTMLElement>('[data-archive]')
  const dialog = root?.querySelector<HTMLDialogElement>('dialog.lightbox')

  if (root && dialog && typeof dialog.showModal === 'function') {
    root.dataset.gallery = 'on'

    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!
    const title = dialog.querySelector<HTMLElement>('.lb-title')!
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!
    const count = dialog.querySelector<HTMLElement>('.lb-count')!

    // Navigation follows the page's own order. Only tiles inside an item with
    // an id count — the "Recently added" row repeats items and must not
    // appear twice in the sequence.
    const tiles = [...root.querySelectorAll<HTMLAnchorElement>('li[id] > a.archive-open')]
    const ids = tiles.map((a) => a.dataset.id!)
    let index = -1

    const preload = (i: number) => {
      const a = tiles[(i + tiles.length) % tiles.length]
      if (a) new Image().src = a.href
    }

    const show = (i: number) => {
      index = (i + tiles.length) % tiles.length
      const a = tiles[index]
      const item = a.closest('li')!
      img.src = a.href
      img.width = Number(a.dataset.w)
      img.height = Number(a.dataset.h)
      img.alt = item.querySelector('.archive-title')?.textContent?.trim() ?? ''
      title.textContent = img.alt
      caption.textContent = item.querySelector('.archive-caption')?.textContent?.trim() ?? ''
      count.textContent = `${index + 1} / ${tiles.length}`
      history.replaceState(null, '', `#${ids[index]}`)
      preload(index + 1)
      preload(index - 1)
    }

    const open = (id: string) => {
      const i = ids.indexOf(id)
      if (i < 0) return
      show(i)
      if (!dialog.open) {
        dialog.showModal()
        dialog.focus({ preventScroll: true })
      }
    }

    root.addEventListener('click', (event) => {
      const a = (event.target as Element).closest<HTMLAnchorElement>('a.archive-open')
      // Let modified clicks (new tab, etc.) behave like the plain links they are.
      if (!a || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()
      open(a.dataset.id!)
    })

    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close())
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1))
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1))

    // On the document, not the dialog: when the viewer opens from a shared
    // link at page load, focus can stay on <body>, and a listener on the
    // dialog would never hear the arrow keys.
    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return
      if (event.key === 'ArrowLeft') show(index - 1)
      else if (event.key === 'ArrowRight') show(index + 1)
    })

    // A click on the backdrop lands on the <dialog> element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })

    let touchX: number | null = null
    dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true })
    dialog.addEventListener('touchend', (e) => {
      if (touchX === null) return
      const dx = e.changedTouches[0].clientX - touchX
      touchX = null
      if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1)
    })

    // Esc, the close button and the backdrop all end here. Drop the photo's
    // hash and hand focus back to the tile, whose position may have moved.
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search)
      tiles[index]?.focus({ preventScroll: true })
      tiles[index]?.scrollIntoView({ block: 'nearest' })
    })

    if (location.hash) open(decodeURIComponent(location.hash.slice(1)))
  }
</script>
