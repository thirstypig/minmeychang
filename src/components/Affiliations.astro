---
import { affiliations } from '../data/affiliations'
import { renderableFacts } from '../data/facts'
import { getTranslation, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// An affiliation whose backing fact is not renderable would be an uncited
// claim. Same gate as the figures.
const renderableIds = new Set(renderableFacts.map((f) => f.id))
const shown = affiliations.filter((a) => renderableIds.has(a.factId))
const anyLogos = shown.some((a) => a.logoPermitted && a.logo)
---

{
  shown.length > 0 && (
    <section class="mt-16">
      <h2 class="text-2xl" style="color: var(--brand)">
        {t('affiliationsHeading')}
      </h2>

      <dl class="mt-7 list-none p-0">
        {shown.map((affiliation) => (
          <div
            class="flex items-center gap-5 border-t py-5"
            style="border-color: var(--rule)"
          >
            {/* Fixed-width column whether or not a mark exists, so every row
                keeps the same left edge and the list reads as a list rather
                than a ragged logo wall.

                The tile is ALWAYS light, never themed. Most of these marks are
                dark ink on transparency — the ACA and Hsi Lai wordmarks
                disappeared entirely against the dark surface. Third-party
                artwork cannot be recoloured to suit a theme (that would be
                modifying the mark), so the background has to accommodate it. */}
            <div class="flex w-20 shrink-0 justify-center">
              {affiliation.logoPermitted && affiliation.logo && (
                <span class="flex h-14 w-20 items-center justify-center rounded bg-white p-1.5">
                  <img
                    src={affiliation.logo}
                    alt=""
                    class="max-h-full max-w-full object-contain"
                    loading="lazy"
                  />
                </span>
              )}
            </div>

            <div class="min-w-0">
              <dt class="text-lg leading-snug" style="color: var(--text-strong)">
                {locale === 'en' ? affiliation.en : affiliation.zhHant}
              </dt>
              <dd class="mt-1 text-base" style="color: var(--brand)">
                {locale === 'en' ? affiliation.roleEn : affiliation.roleZhHant}
              </dd>
            </div>
          </div>
        ))}
      </dl>

      {/* Nominative use depends on not implying endorsement. Saying so plainly
          is the cheapest and most effective mitigation there is. */}
      {anyLogos && (
        <p class="mt-6 text-sm leading-relaxed" style="color: var(--text-soft)">
          {t('marksNotice')}
        </p>
      )}
    </section>
  )
}
