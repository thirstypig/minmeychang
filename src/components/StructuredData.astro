---
import { confirmedFacts } from '../data/facts'
import { affiliations } from '../data/affiliations'
import { type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  canonical: string
}

const { locale, canonical } = Astro.props

// Structured data is a factual claim in machine-readable form, so it obeys the
// same rule as the page: only confirmed and family facts, never unverified
// ones. Everything below traces to an entry in facts.ts.
const has = (id: string) => confirmedFacts.some((f) => f.id === id)

const site = Astro.site?.href ?? 'https://minmeychang.com/'

const person: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site}#person`,
  name: 'Min Mey Chang',
  // The 冠夫姓 form. Included so a search for either name resolves to her —
  // her most-seen work is titled 張校長(馬敏妹), which matches neither the
  // anglicized name nor the full Chinese one.
  //
  // 張馬盈宇 added 2026-08-20. Two newspaper clippings supplied by the family
  // name her that way and not 張馬敏妹: one headlines 「張馬盈宇校長接受表揚狀」
  // and captions her 亞凱迪亞中文學校校長張馬盈宇; the other credits the school's
  // founding to 張馬盈宇女士. Two different papers, agreeing with each other and
  // disagreeing with her own chop, which reads 張馬敏妹.
  //
  // SETTLED 2026-08-20: her name is 張馬敏妹. The family confirmed it, and it
  // is what her own seal reads. The papers were wrong, or were using a name
  // she did not go by.
  //
  // 張馬盈宇 is kept here anyway, and only here — as a SEARCH KEY, so someone
  // holding one of those clippings still arrives at the right person. It is
  // not rendered anywhere a reader sees it as her name. Removing it would cost
  // nothing but findability; keeping it costs nothing but this comment.
  alternateName: [
    '張馬敏妹',
    '張馬盈宇',
    'Min M. Chang',
    'Chang Ma Min-Mey',
    '張校長',
  ],
  url: site,
  image: `${site}og.png`,
  description:
    locale === 'en'
      ? 'Educator, community leader and cultural advocate in Arcadia, California. Founder of the Arcadia Chinese School and co-founder of the Arcadia Chinese Association.'
      : '加州亞凱迪亞的教育家、社區領袖與文化推廣者。亞凱迪亞中文學校創辦人，亞凱迪亞華人協會共同創辦人。',
  jobTitle: locale === 'en' ? 'Educator' : '教育家',
  knowsLanguage: ['en', 'zh-Hant'],
  homeLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Arcadia',
      addressRegion: 'CA',
      addressCountry: 'US',
    },
  },
}

person.spouse = {
  '@type': 'Person',
  name: 'Sheng Chang, M.D.',
  url: 'https://shengchangmd.com',
}

if (has('family')) {
  // Names only. Ages were supplied and are deliberately omitted — they go
  // stale immediately. The grandchildren stay a count: they were not named,
  // and several are likely minors.
  person.children = ['James Chang', 'Peter Chang', 'Richard Chang'].map((name) => ({
    '@type': 'Person',
    name,
  }))
}

if (has('shih-chien')) {
  person.alumniOf = {
    '@type': 'CollegeOrUniversity',
    name: 'Shih Chien University',
    alternateName: '實踐大學',
  }
}

if (has('pta-golden-apple')) {
  person.award = 'Golden Apple Award, Arcadia Unified School District'
}

// Only organizations backed by a confirmed fact.
const confirmedIds = new Set(confirmedFacts.map((f) => f.id))
const orgs = affiliations
  .filter((a) => confirmedIds.has(a.factId))
  .map((a) => ({
    '@type': 'Organization',
    name: a.en,
    alternateName: a.zhHant,
  }))
if (orgs.length > 0) person.affiliation = orgs

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  inLanguage: locale === 'en' ? 'en-US' : 'zh-Hant',
  about: { '@id': `${site}#person` },
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${site}#website`,
    name: 'Min Mey Chang 張馬敏妹',
    url: site,
  },
}
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(person)}
/>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(webPage)}
/>
