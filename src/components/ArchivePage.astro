---
import sharp from 'sharp'
import { type ArchiveItem } from '../data/archive'
import { renderableFacts } from '../data/facts'
import { getTranslation, photoShareText, type Locale } from '../i18n/ui'

// A page made from one archive category (see categoryPages in archive.ts):
// the subject's facts as an intro, then every item shown whole. Used by the
// Calligraphy and Arcadia Chinese School pages.
interface Props {
  locale: Locale
  items: ArchiveItem[]
  /** Facts that make up the intro, in reading order. */
  factIds: string[]
  /** Group items under decade headings, as the archive does. */
  groupByDecade?: boolean
  /** id for the page's top, so an old /archive#<category> link lands here. */
  anchorId?: string
}

const { locale, items, factIds, groupByDecade = false, anchorId } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)
const pick = (v: { en: string; zhHant: string }) => (locale === 'en' ? v.en : v.zhHant)

// The intro IS the facts, read through the same renderable filter as
// Figures.astro: if a fact stops being renderable, its claim leaves this page
// too rather than outliving its source.
const facts = factIds
  .map((id) => renderableFacts.find((f) => f.id === id))
  .filter((f) => f !== undefined)

// Explicit width/height so a shared /<page>#<id> link lands on its item
// instead of where the item was before the images above it loaded.
const dims = new Map(
  await Promise.all(
    items.map(async (i) => {
      const meta = await sharp(`public${i.asset}`).metadata()
      return [i.id, { w: meta.width!, h: meta.height! }] as const
    }),
  ),
)

// Decade groups keep the archive's own anchor ids (<category>-<decade>s), so
// an old /archive#chinese-school-1990s link redirects to the same heading here.
const groups = groupByDecade
  ? [...new Set(items.map((i) => i.decade))]
      .sort((a, b) => a - b)
      .map((decade) => ({
        decade,
        anchor: `${items[0]!.category}-${decade}s`,
        items: items.filter((i) => i.decade === decade),
      }))
  : [{ decade: null, anchor: undefined, items }]
const first = items[0]?.id
---

{/* One fact reads as a sentence. Several are written as standalone list
    items (subjectless: "Founded…", "Built…"), so they render as the Service
    page's list does rather than as a run of fragments posing as prose. */}
<div id={anchorId}>
  {facts.length === 1 ? (
    <p class="text-lg leading-relaxed">{pick(facts[0]!)}</p>
  ) : (
    <ul class="list-none p-0">
      {facts.map((fact) => (
        <li class="border-t py-4 text-lg leading-relaxed" style="border-color: var(--rule)">
          {pick(fact)}
        </li>
      ))}
    </ul>
  )}
</div>

{/* Each item shown whole with its caption and its own share button — no
    thumbnails or full-screen viewer to open first. The button shares this
    item's own #<id> link and passes her name and the caption as the message
    text (see the share script in Base.astro). The first item is above the
    fold, so it loads eagerly; the rest wait until scrolled to. Each button's
    aria-label names its item: a row of identical "Share this photo" buttons
    is indistinguishable to a screen reader out of context. */}
{
  groups.map((group) => (
    <section id={group.anchor} class={`${group.decade ? 'mt-14' : 'mt-10'}`}>
      {group.decade && (
        <h2 class="text-2xl tabular-nums" style="color: var(--text-strong)">
          {group.decade}s
        </h2>
      )}
      <div class={`space-y-12 ${group.decade ? 'mt-6' : ''}`}>
        {group.items.map((item) => (
          <figure id={item.id} class="archive-page-item">
            <img
              src={item.asset}
              width={dims.get(item.id)!.w}
              height={dims.get(item.id)!.h}
              alt={pick({ en: item.en, zhHant: item.zhHant })}
              class="h-auto w-full rounded"
              loading={item.id === first ? 'eager' : 'lazy'}
              decoding="async"
            />
            <figcaption class="mt-3">
              <p style="color: var(--text-strong)">{pick({ en: item.en, zhHant: item.zhHant })}</p>
              {item.caption && (
                <p class="mt-1 text-sm leading-relaxed" style="color: var(--text-soft)">
                  {pick(item.caption)}
                </p>
              )}
              <p class="no-print mt-3">
                <button
                  type="button"
                  class="share-button text-sm"
                  data-share
                  data-share-url={`#${item.id}`}
                  data-share-text={photoShareText(locale, item.caption ? pick(item.caption) : '')}
                  data-label-copied={t('linkCopied')}
                  aria-label={`${t('sharePhoto')}${locale === 'en' ? ': ' : '：'}${pick({ en: item.en, zhHant: item.zhHant })}`}
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="m7 8 5-5 5 5" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" /></svg>
                  <span data-share-label>{t('sharePhoto')}</span>
                </button>
              </p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))
}
