---
import { routes, routePath, type RouteId } from '../i18n/routes'
import {
  getTranslation,
  htmlLang,
  localeNames,
  alternatePath,
  type Locale,
} from '../i18n/ui'

interface Props {
  locale: Locale
  current: RouteId
}

const { locale, current } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

const otherLocale: Locale = locale === 'en' ? 'zh-hant' : 'en'
const otherPath = alternatePath(locale, Astro.url.pathname)
---

{/* Two rows: a utility row (Share on the left; text size, theme, language on
    the right), then every page as a button. Until 2026-11 the pages were one
    row whose links scrolled sideways behind a hidden scrollbar; on a phone
    only about three showed, and nothing said the rest existed. Every page is
    now visible without a swipe or a tap: columns sized in em (see .nav-grid
    in global.css) give 3+3+1 on a phone at normal text, 2+2+2+1 once the
    text-size control enlarges the type, and 4+3 from 640px. */}
<nav
  class="no-print border-b"
  style="border-color: var(--rule)"
  aria-label={t('navLabel')}
>
  <div class="mx-auto max-w-[72ch] px-6 pb-3">
    {/* flex-wrap + ml-auto on the controls: at enlarged text on a narrow phone
        (360px at 1.6x) Share and the controls do not fit one line, and without
        wrapping the language link was pushed off-screen. They wrap instead,
        controls staying right-aligned. */}
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 py-1.5 text-sm">
      {/* Share sits here, at the top of every page, so a reader on a phone
          finds it without scrolling (it was in the footer until 2026-11). It
          opens the phone's own share sheet (Messages, LINE, WhatsApp,
          WeChat…) where the browser supports it; elsewhere it copies the
          link. One button rather than a row of brand icons: the sheet lists
          the apps this reader actually uses, and no third-party widget is
          loaded. Script: Base.astro. */}
      <button
        type="button"
        class="share-button text-sm"
        data-share
        data-label-copied={t('linkCopied')}
      >
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="m7 8 5-5 5 5" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" /></svg>
        <span data-share-label>{t('share')}</span>
      </button>

      <div class="ml-auto flex items-center gap-1">
      <button
        type="button"
        data-type-scale="down"
        class="tap-target px-1.5 leading-none"
        style="color: var(--text-soft)"
        aria-label={t('textSmaller')}
        title={t('textSmaller')}>A</button
      >
      <button
        type="button"
        data-type-scale="up"
        class="tap-target px-1.5 text-lg leading-none"
        style="color: var(--text-soft)"
        aria-label={t('textLarger')}
        title={t('textLarger')}>A</button
      >

      {/* One button, not three. The previous light/dark/system trio spent a
          permanent word ("System") on a state most visitors never change. This
          toggles between light and dark; until it is pressed the site still
          follows the OS, so system remains the default without occupying the
          bar. */}
      <button
        type="button"
        data-theme-toggle
        class="tap-target px-1.5"
        style="color: var(--text-soft)"
        aria-label={t('themeToggle')}
        title={t('themeToggle')}><span data-theme-icon>☾</span></button
      >

      <a
        href={otherPath}
        hreflang={htmlLang[otherLocale]}
        lang={htmlLang[otherLocale]}
        class="tap-target whitespace-nowrap pl-1 underline underline-offset-4 decoration-1"
        style="color: var(--brand)"
      >
        {localeNames[otherLocale]}
      </a>
      </div>
    </div>

    <ul class="nav-grid list-none p-0">
      {
        routes.map((route) => (
          <li>
            <a
              href={routePath(locale, route.id)}
              aria-current={route.id === current ? 'page' : undefined}
              class="nav-button"
            >
              {t(route.navLabelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script is:inline>
  ;(function () {
    var root = document.documentElement
    var MIN = 0.9
    var MAX = 1.6

    function effectiveTheme() {
      if (root.dataset.theme) return root.dataset.theme
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light'
    }

    function paintIcon() {
      // Show the state you would switch TO, which is the convention people
      // read fastest on a single-button toggle.
      var next = effectiveTheme() === 'dark' ? 'light' : 'dark'
      document.querySelectorAll('[data-theme-icon]').forEach(function (icon) {
        icon.textContent = next === 'dark' ? '☾' : '☀'
      })
    }

    document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
      button.addEventListener('click', function () {
        var next = effectiveTheme() === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('theme', next)
        } catch (e) {}
        paintIcon()
      })
    })

    document.querySelectorAll('[data-type-scale]').forEach(function (button) {
      button.addEventListener('click', function () {
        var step = button.getAttribute('data-type-scale') === 'up' ? 0.1 : -0.1
        var current = parseFloat(
          getComputedStyle(root).getPropertyValue('--type-scale') || '1'
        )
        var next = Math.min(MAX, Math.max(MIN, Math.round((current + step) * 10) / 10))
        root.style.setProperty('--type-scale', String(next))
        try {
          localStorage.setItem('type-scale', String(next))
        } catch (e) {}
      })
    })

    paintIcon()
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', paintIcon)
  })()
</script>
