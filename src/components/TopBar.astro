---
import { routes, routePath, type RouteId } from '../i18n/routes'
import {
  getTranslation,
  htmlLang,
  localeNames,
  alternatePath,
  type Locale,
} from '../i18n/ui'

interface Props {
  locale: Locale
  current: RouteId
}

const { locale, current } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

const otherLocale: Locale = locale === 'en' ? 'zh-hant' : 'en'
const otherPath = alternatePath(locale, Astro.url.pathname)
---

{/* Two rows: a slim utility row (text size, theme, language), then every page
    as a button. Until 2026-11 this was one row whose links scrolled sideways
    behind a hidden scrollbar; on a phone only about three of six showed, and
    nothing said the rest existed. Every page is now visible without a swipe
    or a tap: one row of six from 640px up; below that, columns sized in em
    (see .nav-grid in global.css), which gives 3×2 at normal text and 2×3
    once the text-size control enlarges the type, so no label overflows. */}
<nav
  class="no-print border-b"
  style="border-color: var(--rule)"
  aria-label={t('navLabel')}
>
  <div class="mx-auto max-w-[72ch] px-6 pb-3">
    <div class="flex items-center justify-end gap-1 py-1.5 text-sm">
      <button
        type="button"
        data-type-scale="down"
        class="tap-target px-1.5 leading-none"
        style="color: var(--text-soft)"
        aria-label={t('textSmaller')}
        title={t('textSmaller')}>A</button
      >
      <button
        type="button"
        data-type-scale="up"
        class="tap-target px-1.5 text-lg leading-none"
        style="color: var(--text-soft)"
        aria-label={t('textLarger')}
        title={t('textLarger')}>A</button
      >

      {/* One button, not three. The previous light/dark/system trio spent a
          permanent word ("System") on a state most visitors never change. This
          toggles between light and dark; until it is pressed the site still
          follows the OS, so system remains the default without occupying the
          bar. */}
      <button
        type="button"
        data-theme-toggle
        class="tap-target px-1.5"
        style="color: var(--text-soft)"
        aria-label={t('themeToggle')}
        title={t('themeToggle')}><span data-theme-icon>☾</span></button
      >

      <a
        href={otherPath}
        hreflang={htmlLang[otherLocale]}
        lang={htmlLang[otherLocale]}
        class="tap-target whitespace-nowrap pl-1 underline underline-offset-4 decoration-1"
        style="color: var(--brand)"
      >
        {localeNames[otherLocale]}
      </a>
    </div>

    <ul class="nav-grid list-none p-0">
      {
        routes.map((route) => (
          <li>
            <a
              href={routePath(locale, route.id)}
              aria-current={route.id === current ? 'page' : undefined}
              class="nav-button"
            >
              {t(route.navLabelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script is:inline>
  ;(function () {
    var root = document.documentElement
    var MIN = 0.9
    var MAX = 1.6

    function effectiveTheme() {
      if (root.dataset.theme) return root.dataset.theme
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light'
    }

    function paintIcon() {
      // Show the state you would switch TO, which is the convention people
      // read fastest on a single-button toggle.
      var next = effectiveTheme() === 'dark' ? 'light' : 'dark'
      document.querySelectorAll('[data-theme-icon]').forEach(function (icon) {
        icon.textContent = next === 'dark' ? '☾' : '☀'
      })
    }

    document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
      button.addEventListener('click', function () {
        var next = effectiveTheme() === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('theme', next)
        } catch (e) {}
        paintIcon()
      })
    })

    document.querySelectorAll('[data-type-scale]').forEach(function (button) {
      button.addEventListener('click', function () {
        var step = button.getAttribute('data-type-scale') === 'up' ? 0.1 : -0.1
        var current = parseFloat(
          getComputedStyle(root).getPropertyValue('--type-scale') || '1'
        )
        var next = Math.min(MAX, Math.max(MIN, Math.round((current + step) * 10) / 10))
        root.style.setProperty('--type-scale', String(next))
        try {
          localStorage.setItem('type-scale', String(next))
        } catch (e) {}
      })
    })

    paintIcon()
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', paintIcon)
  })()
</script>
