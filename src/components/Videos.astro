---
import { videosByReach, watchUrl, thumbnailUrl } from '../data/videos'
import { getTranslation, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** How many to show. Omit for all. */
  limit?: number
}

const { locale, limit } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

const shown = limit ? videosByReach.slice(0, limit) : videosByReach

// Views are a snapshot, not live. Format compactly rather than implying a
// precision the site cannot maintain.
const fmt = (n: number) =>
  new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'zh-Hant', {
    notation: 'compact',
    maximumFractionDigits: 1,
  }).format(n)
---

<ul class="mt-8 grid gap-8 sm:grid-cols-2 list-none p-0">
  {
    shown.map((video, index) => (
      <li>
        <a href={watchUrl(video)} rel="noopener" class="group block">
          <div
            class="relative overflow-hidden rounded"
            style="background: var(--rule)"
          >
            {/*
              aspect-video + object-cover: hqdefault is 4:3 with letterboxing,
              so cropping to 16:9 removes the black bars rather than framing
              them.

              loading: the first thumbnail is usually above the fold; the rest
              are not, and each one is a third-party request.

              referrerpolicy: Google sees that a thumbnail was fetched, but not
              which page fetched it.
            */}
            <img
              src={thumbnailUrl(video)}
              alt=""
              width="480"
              height="360"
              class="aspect-video w-full object-cover"
              loading={index === 0 ? 'eager' : 'lazy'}
              referrerpolicy="no-referrer"
            />
            <span
              class="absolute bottom-2 right-2 rounded px-2 py-0.5 text-xs tabular-nums"
              style="background: var(--brand); color: var(--brand-contrast)"
            >
              {fmt(video.views)} {t('viewsLabel')}
            </span>
          </div>

          <p
            class="mt-3 underline-offset-4 group-hover:underline"
            style="color: var(--brand)"
          >
            {/* The titles are Chinese on both locales because that is how she
                titled them. Marking the language keeps screen readers correct
                on the English page. */}
            <span lang="zh-Hant">{video.title}</span>
          </p>

          {!video.ownChannel && video.hostChannel && (
            <p class="mt-1 text-sm" style="color: var(--text-soft)">
              {t('onChannelOf')} <span lang="zh-Hant">{video.hostChannel}</span>
            </p>
          )}
        </a>
      </li>
    ))
  }
</ul>
