---
import { readingOrder, routePath } from '../i18n/routes'
import { confirmedFacts } from '../data/facts'
import { getTranslation, type Locale } from '../i18n/ui'
import Figures from './Figures.astro'
import NameSeal from './NameSeal.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

// Sourced from facts.ts rather than duplicated — her name lives in one place,
// and renders only while the fact stays confirmed.
const chineseName = confirmedFacts.find((f) => f.id === 'chinese-name')?.zhHant
const englishName = getTranslation('en', 'siteName')
---

<div class="pt-6 sm:pt-10">
  <NameSeal size={56} class="mb-7" />
  {/* Her name IS the mark. No separate logo: a seal carrying only 張 named her
      husband's family rather than her, and 張馬敏妹 is the whole point — the
      冠夫姓 form carries her own maiden surname 馬 inside it. */}
  <h1 class="text-4xl sm:text-6xl tracking-tight" style="color: var(--brand)">
    {t('siteName')}
    {
      locale === 'en'
        ? chineseName && (
            <span
              lang="zh-Hant"
              class="mt-3 block text-2xl sm:text-3xl font-normal tracking-normal"
              style="color: var(--text-soft)"
            >
              {chineseName}
            </span>
          )
        : (
            <span
              lang="en"
              class="mt-3 block text-2xl sm:text-3xl font-normal tracking-normal"
              style="color: var(--text-soft)"
            >
              {englishName}
            </span>
          )
    }
  </h1>

  <p
    class="mt-8 text-xl sm:text-2xl leading-relaxed"
    style="color: var(--text-strong)"
  >
    {t('siteTagline')}
  </p>

  <p class="mt-5 text-base leading-relaxed" style="color: var(--text-soft)">
    {t('homeIntro')}
  </p>

  <Figures locale={locale} />

  {/* Large, plainly-labelled destinations rather than a menu bar alone.
      Senior-UX guidance: big targets, one function per link, no sublevels. */}
  <ul class="mt-14 grid gap-px list-none p-0" style="background: var(--rule)">
    {
      readingOrder.map((route) => (
        <li style="background: var(--surface)">
          <a
            href={routePath(locale, route.id)}
            class="flex items-center justify-between gap-4 py-5 text-xl underline-offset-4 hover:underline"
            style="color: var(--brand)"
          >
            <span>{t(route.labelKey)}</span>
            <span aria-hidden="true" style="color: var(--text-soft)">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
