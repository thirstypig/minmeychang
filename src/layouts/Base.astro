---
import '../styles/global.css'
import TopBar from '../components/TopBar.astro'
import StructuredData from '../components/StructuredData.astro'
import {
  type Locale,
  getTranslation,
  htmlLang,
  alternatePath,
  reviewed,
} from '../i18n/ui'
import { type RouteId } from '../i18n/routes'
import { spouse, grandchildren } from '../data/family'

interface Props {
  locale: Locale
  current: RouteId
  title?: string
  description?: string
}

const { locale, current, title, description } = Astro.props

const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

const pageTitle = title ?? t('siteName')
const pageDescription = description ?? t('siteTagline')

const path = Astro.url.pathname
const otherLocale: Locale = locale === 'en' ? 'zh-hant' : 'en'
const otherPath = alternatePath(locale, path)

const canonical = new URL(path, Astro.site)
const enHref = new URL(locale === 'en' ? path : otherPath, Astro.site)
const zhHref = new URL(locale === 'en' ? otherPath : path, Astro.site)
const ogImage = new URL('/og.png', Astro.site)

// Crawlers are blocked unless explicitly allowed AND this locale's copy has
// been reviewed by a fluent reader. Both conditions, not either.
const allowIndexing = process.env.ALLOW_INDEXING === 'true'
const indexable = allowIndexing && reviewed[locale]
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enHref.href} />
    <link rel="alternate" hreflang="zh-Hant" href={zhHref.href} />
    <link rel="alternate" hreflang="x-default" href={enHref.href} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {
      indexable && (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1"
        />
      )
    }
    <StructuredData locale={locale} canonical={canonical.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Share previews. Without these, sending this link in WhatsApp, WeChat or
        iMessage shows a bare gray URL — which is exactly how her community
        will receive the site. */}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Min Mey Chang 張馬敏妹" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Min Mey Chang 張馬敏妹" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'en' ? 'zh_TW' : 'en_US'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    {/* Must run before first paint and must NOT be deferred: without it, a
        visitor who chose light sees a dark flash on every navigation. is:inline
        keeps Astro from bundling and deferring it. */}
    <script is:inline>
      ;(function () {
        try {
          var theme = localStorage.getItem('theme')
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme
          }
          var scale = localStorage.getItem('type-scale')
          if (scale) {
            document.documentElement.style.setProperty('--type-scale', scale)
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#main">{t('skipToContent')}</a>

    <TopBar locale={locale} current={current} />

    <main id="main">
      <slot />
    </main>

    {/* All four destinations verified reachable 2026-08-05 — see the `verified`
        field in src/data/family.ts. Each domain is the person's own name and
        each site titles itself with it, so linking exposes no name that was not
        already public. */}
    <footer class="mt-8 border-t" style="border-color: var(--rule)">
      <div class="mx-auto max-w-[68ch] px-6 py-8 text-base">
        {
          spouse && (
            <p style="color: var(--text-soft)">
              {t('husbandLead')}:{' '}
              <a
                href={spouse.url}
                rel="noopener"
                class="tap-target underline underline-offset-4"
                style="color: var(--brand)"
              >
                <span lang={locale === 'en' ? 'en' : 'zh-Hant'}>
                  {locale === 'en' ? spouse.name : (spouse.nameZhHant ?? spouse.name)}
                </span>
              </a>
            </p>
          )
        }

        {
          grandchildren.length > 0 && (
            <p class="mt-2" style="color: var(--text-soft)">
              {t('grandchildrenLead')}:{' '}
              {grandchildren.map((member, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">{' · '}</span>}
                  <a
                    href={member.url}
                    rel="noopener"
                    class="tap-target underline underline-offset-4"
                    style="color: var(--brand)"
                  >
                    {/* No nameZhHant for any of them, and none is invented —
                        their sites publish Latin names only. */}
                    <span lang="en">{member.name}</span>
                  </a>
                </>
              ))}
            </p>
          )
        }

        <p class="mt-4 no-print" style="color: var(--text-soft)">
          {t('publishedBy')}
        </p>
      </div>
    </footer>
  </body>
</html>
