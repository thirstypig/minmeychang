---
import '../styles/global.css'
import SiteControls from '../components/SiteControls.astro'
import {
  type Locale,
  getTranslation,
  htmlLang,
  localeNames,
  alternatePath,
  reviewed,
} from '../i18n/ui'

interface Props {
  locale: Locale
  title?: string
  description?: string
}

const { locale, title, description } = Astro.props

const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key)

const pageTitle = title ?? t('siteName')
const pageDescription = description ?? t('siteTagline')

const path = Astro.url.pathname
const otherLocale: Locale = locale === 'en' ? 'zh-hant' : 'en'
const otherPath = alternatePath(locale, path)

const canonical = new URL(path, Astro.site)
const enHref = new URL(locale === 'en' ? path : otherPath, Astro.site)
const zhHref = new URL(locale === 'en' ? otherPath : path, Astro.site)
const ogImage = new URL('/og.png', Astro.site)

// Crawlers are blocked unless explicitly allowed AND this locale's copy has
// been reviewed by a fluent reader. Both conditions, not either.
const allowIndexing = process.env.ALLOW_INDEXING === 'true'
const indexable = allowIndexing && reviewed[locale]
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enHref.href} />
    <link rel="alternate" hreflang="zh-Hant" href={zhHref.href} />
    <link rel="alternate" hreflang="x-default" href={enHref.href} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Share previews. Without these, sending this link in WhatsApp, WeChat or
        iMessage shows a bare grey URL — which is exactly how her community
        will receive the site. */}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Min Mey Chang 張馬敏妹" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Min Mey Chang 張馬敏妹" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'en' ? 'zh_TW' : 'en_US'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    {/* Must run before first paint and must NOT be deferred: without it, a
        visitor who chose light sees a dark flash on every navigation. is:inline
        keeps Astro from bundling and deferring it. */}
    <script is:inline>
      ;(function () {
        try {
          var theme = localStorage.getItem('theme')
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme
          }
          var scale = localStorage.getItem('type-scale')
          if (scale) {
            document.documentElement.style.setProperty('--type-scale', scale)
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#main">{t('skipToContent')}</a>

    <div class="mx-auto max-w-[68ch] px-6">
      <nav
        class="no-print flex flex-wrap items-center justify-between gap-3 py-3"
        aria-label={t('switchLanguage')}
      >
        <SiteControls locale={locale} />
        <a
          href={otherPath}
          hreflang={htmlLang[otherLocale]}
          lang={htmlLang[otherLocale]}
          class="tap-target text-sm underline underline-offset-4 decoration-1"
          style="color: var(--brand)"
        >
          {localeNames[otherLocale]}
        </a>
      </nav>
    </div>

    <main id="main">
      <slot />
    </main>

    {/* Verified live 2026-08-05: shengchangmd.com resolves to GitHub Pages and
        serves the practice site. The apex migration described as "planned but
        not started" in that repo's runbook has in fact completed — the old
        shengchangmd.bahtzang.com subdomain now 404s. Link the apex. */}
    <footer class="mt-8 border-t" style="border-color: var(--rule)">
      <div class="mx-auto max-w-[68ch] px-6 py-8 text-base">
        <p style="color: var(--text-soft)">
          {t('husbandLead')}:{' '}
          <a
            href="https://shengchangmd.com"
            rel="noopener"
            class="tap-target underline underline-offset-4"
            style="color: var(--brand)"
          >
            <span lang={locale === 'en' ? 'en' : 'zh-Hant'}>{t('husbandName')}</span>
          </a>
        </p>
        <p class="mt-3 no-print" style="color: var(--text-soft)">
          {t('publishedBy')}
        </p>
      </div>
    </footer>
  </body>
</html>
